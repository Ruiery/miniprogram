.game-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5E6 0%, #FFE8CC 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(139, 69, 19, 0.06);
}

.nav-back, .nav-retry {
  font-size: 30rpx;
  color: #8B4513;
  padding: 10rpx 20rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5C3317;
}

/* 面包屑 */
.breadcrumb {
  text-align: center;
  font-size: 24rpx;
  color: #A0522D;
  padding: 10rpx 0;
}

/* 提示文字 */
.hint-text {
  text-align: center;
  font-size: 28rpx;
  color: #8B4513;
  font-weight: bold;
  padding: 16rpx 0;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  padding: 10rpx 0 20rpx;
}

/* 游戏主区域 */
.game-area {
  position: relative;
  margin: 0 auto;
  flex-shrink: 0;
}

.character-img {
  display: block;
}

/* 热区层 */
.zones-layer {
  position: absolute;
  top: 0;
  left: 0;
}

.zone {
  position: absolute;
  border: 3rpx dashed rgba(139, 69, 19, 0.4);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: border-color 0.15s, background-color 0.15s;
  background-color: rgba(255, 255, 255, 0.1);
}

.zone-hover {
  border-color: #D4A574 !important;
  background-color: rgba(212, 165, 116, 0.25) !important;
  box-shadow: 0 0 20rpx rgba(212, 165, 116, 0.4);
}

.zone-correct {
  border: 3rpx solid #6B8E23 !important;
  background-color: rgba(107, 142, 35, 0.15) !important;
  animation: zoneSuccess 0.4s ease-out;
}

.zone-wrong {
  border-color: #CD5C5C !important;
  background-color: rgba(205, 92, 92, 0.2) !important;
  animation: zoneShake 0.3s ease-out;
}

@keyframes zoneSuccess {
  0% { transform: scale(1); }
  50% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes zoneShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

.zone-number {
  font-size: 36rpx;
  font-weight: bold;
  color: rgba(139, 69, 19, 0.5);
}

.zone-accessory {
  width: 80%;
  height: 80%;
}

.zone-check {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  font-size: 28rpx;
  color: #6B8E23;
  background: #fff;
  border-radius: 50%;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border: 2rpx solid #6B8E23;
}

/* 拖拽幽灵元素 */
.drag-ghost {
  position: fixed;
  pointer-events: none;
  z-index: 9999;
  transition: none;
}

/* 底部饰品栏 */
.accessory-bar {
  margin-top: auto;
  padding: 20rpx 0 40rpx;
  background: linear-gradient(180deg, transparent, rgba(139, 69, 19, 0.06));
  white-space: nowrap;
}

.accessory-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 0 30rpx;
}

.accessory-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  border: 3rpx solid #E8D4BC;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.accessory-item:active {
  border-color: #D4A574;
  transform: scale(0.95);
}

.accessory-item.used {
  opacity: 0.3;
  pointer-events: none;
}

.used-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
