/* 遮罩层 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  pointer-events: none;
  transition: background 0.25s ease;
}

.modal-mask.show {
  background: rgba(0, 0, 0, 0.55);
  pointer-events: auto;
}

/* 弹窗卡片 */
.modal-content {
  width: 560rpx;
  background: linear-gradient(180deg, #FFFAF5, #FFF0E0);
  border-radius: 32rpx;
  padding: 50rpx 40rpx 40rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
  transform: scale(0.8) translateY(40rpx);
  opacity: 0;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
}

.modal-content.slide-in {
  transform: scale(1) translateY(0);
  opacity: 1;
}

/* 图标 */
.result-icon {
  display: block;
  font-size: 88rpx;
  margin-bottom: 16rpx;
}

.win-icon {
  animation: winBounce 0.6s ease-out;
}

.fail-icon {
  animation: failShake 0.5s ease-out;
}

@keyframes winBounce {
  0% { transform: scale(0) rotate(-10deg); }
  60% { transform: scale(1.15) rotate(3deg); }
  100% { transform: scale(1) rotate(0); }
}

@keyframes failShake {
  0%, 100% { transform: translateX(0); }
  15% { transform: translateX(-10rpx); }
  30% { transform: translateX(10rpx); }
  45% { transform: translateX(-8rpx); }
  60% { transform: translateX(8rpx); }
  75% { transform: translateX(-4rpx); }
  90% { transform: translateX(4rpx); }
}

/* 标题 */
.result-title {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.win-title {
  color: #D4A574;
}

.fail-title {
  color: #8B4513;
}

.result-subtitle {
  display: block;
  font-size: 26rpx;
  color: #A0522D;
  margin-bottom: 20rpx;
}

.result-level {
  display: block;
  font-size: 28rpx;
  color: #5C3317;
  margin-bottom: 24rpx;
}

/* 统计信息 */
.result-stats {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0E8E0;
}

.stat-row:last-child {
  border-bottom: none;
}

.stat-label {
  font-size: 28rpx;
  color: #A0522D;
}

.stat-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #5C3317;
}

.error-value {
  color: #CD5C5C;
}

/* 按钮 */
.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #D4A574, #C8945A);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(212, 165, 116, 0.35);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-secondary {
  background: transparent;
  color: #A0522D;
  border: 2rpx solid #E8D4BC !important;
}

.btn-secondary:active {
  background: #FFF5E6;
}
