.timer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 28rpx;
  background: linear-gradient(135deg, #FFF8F0, #FFE8D0);
  border-radius: 40rpx;
  border: 2rpx solid #E8D4BC;
}

.timer-icon {
  font-size: 28rpx;
}

.timer-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #5C3317;
  font-variant-numeric: tabular-nums;
  min-width: 100rpx;
}

/* 警告状态（剩余 ≤ 10秒） */
.timer-warning {
  background: linear-gradient(135deg, #FFF0F0, #FFE0E0);
  border-color: #CD5C5C;
  animation: timerPulse 0.5s ease-in-out infinite alternate;
}

.timer-warning .timer-text {
  color: #CD5C5C;
}

@keyframes timerPulse {
  from { transform: scale(1); }
  to { transform: scale(1.04); }
}
